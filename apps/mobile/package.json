{
  "name": "@life-weather/mobile",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@life-weather/contracts": "workspace:*",
    "@life-weather/lifestyle-engine": "workspace:*",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.4",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.5",
    "expo-linking": "~57.0.2",
    "expo-router": "~57.0.4",
    "expo-splash-screen": "~57.0.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "4.25.2",
    "react-native-web": "~0.21.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.0",
    "typescript": "~6.0.3",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "start": "expo start",
    "dev": "expo start --dev-client",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "pnpm -w run build:api-runtime-packages && pnpm run typecheck:workspace",
    "typecheck:workspace": "tsc --noEmit",
    "test": "pnpm -w run build:api-runtime-packages && pnpm run test:workspace",
    "test:workspace": "vitest run",
    "export:android:check": "expo export --clear --platform android --output-dir .expo/android-export-check"
  },
  "private": true
}
