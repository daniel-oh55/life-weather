# Public Life Weather API origin or optional base path.
# Do not include the /weather segment. This value is not a provider API key.
EXPO_PUBLIC_API_BASE_URL=

# Final Android application/package identifier (e.g. com.example.app). Read only by
# app.config.ts. Required for a real production EAS build; otherwise expo.android.package is
# simply omitted.
LIFE_WEATHER_ANDROID_PACKAGE=

# AdMob Android App ID (ca-app-pub-...~...). Read only by app.config.ts for the Google Mobile
# Ads Expo config plugin. Required for a real production EAS build; otherwise Google's
# documented sample/test Android App ID is used instead.
LIFE_WEATHER_ADMOB_ANDROID_APP_ID=

# AdMob ad-unit ID for the single Today-screen adaptive banner (ca-app-pub-.../...). Required
# for a real production EAS build; in a development runtime the library's own test ad-unit ID
# is used instead, never this value.
EXPO_PUBLIC_ADMOB_TODAY_BANNER_UNIT_ID=

# Public, absolute HTTPS URL of the published privacy policy page. Required for a real
# production EAS build. Not a provider API key.
EXPO_PUBLIC_PRIVACY_POLICY_URL=
